{
  "name": "hacksis-card-validator",
  "version": "1.0.1",
  "private": true,
  "description": "SDK de navegador para lectura de tarjetas universitarias peruanas",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "pack:local": "npm run build && npm pack"
  },
  "dependencies": {
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
